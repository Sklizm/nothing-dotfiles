{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/nothing-logo.txt",
    "color": {
      "1": "white",
      "2": "8"
    },
    "padding": {
      "top": 1,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "white",
      "output": "8"
    },
    "key": {
      "width": 8
    }
  },
  "modules": [
    { "type": "custom", "format": "" },
    { "type": "custom", "format": "\u001b[1;37mcodrin\u001b[0m\u001b[90m@\u001b[0m\u001b[1;37mfedora\u001b[0m" },
    { "type": "custom", "format": "\u001b[90m─────────────────────\u001b[0m" },
    { "type": "os",       "key": "os" },
    { "type": "kernel",   "key": "kn" },
    { "type": "uptime",   "key": "up" },
    { "type": "shell",    "key": "sh" },
    { "type": "terminal", "key": "tm" },
    { "type": "de",       "key": "de" },
    { "type": "wm",       "key": "wm" },
    { "type": "font",     "key": "ft" },
    { "type": "cpu",      "key": "cpu" },
    { "type": "gpu",      "key": "gpu" },
    { "type": "memory",   "key": "mem" },
    { "type": "disk",     "key": "fs" },
    { "type": "custom",   "format": "" }
  ]
}
